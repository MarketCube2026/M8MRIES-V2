generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
}
enum ApplicationStatus {
  DRAFT
  EXTRACTED
  REVIEWING
  PENDING_APPROVAL
  APPROVED
  REJECTED
  REVIEW_REQUIRED
  @@map("v2_application_status")
}
enum UserRole {
  APPLICANT
  EVALUATOR
  APPROVER
  @@map("v2_user_role")
}
model UserAccess {
  userId String @id @db.Uuid
  role UserRole
  active Boolean @default(true)
  @@map("v2_user_access")
}
model Application {
  id String @id @default(cuid())
  projectId String @unique
  applicationNo String @unique
  ownerId String? @db.Uuid
  status ApplicationStatus @default(DRAFT)
  region String?
  district String?
  applicant String?
  hospital String?
  kol String?
  projectName String?
  meetingDate DateTime?
  requestedAmount Decimal? @db.Decimal(16, 4)
  sourceSystem String @default("V2")
  legacyId String?
  legacyStatus String?
  migrationBatch String?
  originalSnapshot Json?
  narrativeOverride String?
  revision Int @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  attachments Attachment[]
  fields ExtractedField[]
  scores ScoreBreakdown[]
  evaluations Evaluation[]
  approvals Approval[]
  ledgerEntries LedgerEntry[]
  reviews PostEventReview[]
  audits AuditLog[]
  ocrRuns OcrRun[]
  @@unique([sourceSystem, legacyId])
  @@index([ownerId])
  @@map("v2_applications")
}
model Attachment {
  id String @id @default(cuid())
  applicationId String
  fileName String
  filePath String
  mimeType String
  fileHash String
  ocrText String?
  extractionStatus String @default("UPLOADED")
  createdAt DateTime @default(now())
  application Application @relation(fields: [applicationId], references: [id])
  @@map("v2_attachments")
}
model ExtractedField {
  id String @id @default(cuid())
  applicationId String
  key String
  sourceValue String?
  confirmedValue String?
  sourceText String?
  confidence Float @default(0)
  needsConfirmation Boolean @default(true)
  application Application @relation(fields: [applicationId], references: [id])
  @@unique([applicationId, key])
  @@map("v2_extracted_fields")
}
model ScoreBreakdown {
  id String @id @default(cuid())
  applicationId String
  key String
  category String
  option String?
  score Int?
  maxScore Int?
  confirmed Boolean @default(false)
  evidence String?
  ruleVersion String @default("2026.1")
  application Application @relation(fields: [applicationId], references: [id])
  @@unique([applicationId, key])
  @@map("v2_score_breakdowns")
}
model Evaluation {
  id String @id @default(cuid())
  applicationId String
  rawScore Int?
  percentile Float?
  grade String?
  recommendedRange String?
  defaultAmount Decimal? @db.Decimal(16, 4)
  completeness Float?
  minPossible Int?
  maxPossible Int?
  confidence Float?
  missingKeys String[] @default([])
  risks String?
  narrative String?
  ruleVersion String @default("2026.1")
  createdAt DateTime @default(now())
  application Application @relation(fields: [applicationId], references: [id])
  @@map("v2_evaluations")
}
model Approval {
  id String @id @default(cuid())
  applicationId String
  decision String
  approvedAmount Decimal? @db.Decimal(16, 4)
  reason String?
  approver String
  createdAt DateTime @default(now())
  application Application @relation(fields: [applicationId], references: [id])
  @@map("v2_approvals")
}
model LedgerEntry {
  id String @id @default(cuid())
  applicationId String @unique
  region String?
  hospital String?
  kol String?
  product String?
  requestedAmount Decimal? @db.Decimal(16, 4)
  recommendedAmount Decimal? @db.Decimal(16, 4)
  approvedAmount Decimal? @db.Decimal(16, 4)
  actualAmount Decimal? @db.Decimal(16, 4)
  note String?
  year Int
  deletedAt DateTime?
  createdAt DateTime @default(now())
  application Application @relation(fields: [applicationId], references: [id])
  @@map("v2_ledger_entries")
}
model PostEventReview {
  id String @id @default(cuid())
  applicationId String
  targetSales Decimal? @db.Decimal(16, 4)
  actualSales Decimal? @db.Decimal(16, 4)
  incrementalSales Decimal? @db.Decimal(16, 4)
  coveredDepartments String?
  actualSpend Decimal? @db.Decimal(16, 4)
  roi Float?
  conclusion String?
  createdAt DateTime @default(now())
  application Application @relation(fields: [applicationId], references: [id])
  @@map("v2_post_event_reviews")
}
model AuditLog {
  id String @id @default(cuid())
  applicationId String?
  actor String
  role UserRole
  action String
  beforeJson String?
  afterJson String?
  reason String?
  createdAt DateTime @default(now())
  application Application? @relation(fields: [applicationId], references: [id])
  @@map("v2_audit_logs")
}
model RuleOption {
  id String @id @default(cuid())
  key String
  label String
  score Int
  maxScore Int
  category String
  active Boolean @default(true)
  ruleVersion String @default("2026.1")
  @@unique([key, label])
  @@map("v2_rule_options")
}
model AmountBand {
  id String @id @default(cuid())
  minScore Int @unique
  maxScore Int?
  grade String
  rangeLabel String
  defaultAmount Decimal @db.Decimal(16, 4)
  @@map("v2_amount_bands")
}
model OcrRun {
  id String @id @default(cuid())
  applicationId String
  status String
  sourceFile String
  fileHash String
  ruleVersion String
  ocrProvider String @default("PaddleOCR")
  llmProvider String @default("DeepSeek")
  errorMessage String?
  ocrText String?
  resultJson Json?
  createdAt DateTime @default(now())
  completedAt DateTime?
  application Application @relation(fields: [applicationId], references: [id])
  @@map("v2_ocr_runs")
}
