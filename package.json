{
  "name": "approval-insight",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "overrides": {
    "deepmerge-ts": "8.0.2"
  },
  "scripts": {
    "dev": "concurrently \"tsx server/index.ts\" \"vite\"",
    "dev:local": "concurrently -k -n API,WEB,OCR \"node server/mock.cjs\" \"vite --host 0.0.0.0 --port 5174\" \"powershell -NoProfile -ExecutionPolicy Bypass -File ocr_server/start_ocr_server.ps1\"",
    "build": "tsc -b && vite build",
    "test": "vitest run",
    "start": "tsx server/index.ts",
    "backup": "node scripts/backup.mjs",
    "typecheck": "tsc --noEmit",
    "db:deploy": "prisma migrate deploy",
    "migrate:legacy": "node scripts/migrate-legacy.mjs",
    "migrate:reconcile": "node scripts/reconcile.mjs",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:seed": "tsx prisma/seed.ts",
    "ocr:install": "python -m pip install -r ocr_server/requirements.txt",
    "ocr:start": "powershell -ExecutionPolicy Bypass -File ocr_server/start_ocr_server.ps1"
  },
  "dependencies": {
    "@prisma/client": "^6.15.0",
    "@supabase/supabase-js": "^2.116.0",
    "cors": "^2.8.5",
    "csv-parse": "^7.0.2",
    "dotenv": "^17.4.2",
    "express": "^5.1.0",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.0.2",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.0.0",
    "@types/node": "^24.3.0",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^5.0.2",
    "concurrently": "^9.2.1",
    "prisma": "^6.15.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vite": "^7.1.3",
    "vitest": "^3.2.4"
  }
}
